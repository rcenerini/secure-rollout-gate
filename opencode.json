{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "gh *",
      "effect": "deny"
    },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "deny" },
    { "action": "shell", "resource": "wget *", "effect": "deny" },
    { "action": "shell", "resource": "Invoke-WebRequest *", "effect": "deny" },
    { "action": "shell", "resource": "iwr *", "effect": "deny" },
    { "action": "shell", "resource": "irm *", "effect": "deny" }
  ],
  "agents": {
    "cloud-auditor": {
      "disabled": true
    },
    "cybersec-architect": {
      "disabled": true
    },
    "doc-security-architect": {
      "disabled": true
    },
    "docs": {
      "disabled": true
    },
    "git": {
      "disabled": true
    },
    "identity-architect": {
      "disabled": true
    },
    "infosec-architect": {
      "disabled": true
    },
    "po-pm": {
      "disabled": true
    },
    "qa-engineer": {
      "disabled": true
    },
    "readme-designer": {
      "disabled": true
    },
    "sdd-architect": {
      "disabled": true
    },
    "squad-orchestrator": {
      "disabled": true
    },
    "threat-model": {
      "disabled": true
    }
  }
}
